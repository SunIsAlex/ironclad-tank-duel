{
  "name": "tank-duel-2d",
  "version": "1.0.0",
  "description": "支持人机、本地双人和 EdgeOne Pages 配对联机的 2D 坦克炮战游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:edgeone": "edgeone pages dev",
    "build": "tsc -b && vite build",
    "train:ai": "node scripts/train-offline-ai.mjs",
    "train:ai:elite": "node scripts/train-elite-ai.mjs",
    "train:ai:weapons": "node scripts/train-weapon-policy.mjs",
    "train:ai:portals": "node scripts/train-portal-ai.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "tank",
    "artillery",
    "turn-based",
    "canvas",
    "typescript",
    "pwa"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
